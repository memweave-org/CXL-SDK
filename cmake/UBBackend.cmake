# A single selection for the entire build, propagated by shm-lib.
set(_ub_default none)
if(DEFINED ENV{SHM_UB_API})
  set(_ub_default "$ENV{SHM_UB_API}")
elseif(WITH_UB)
  set(_ub_default memlink)
endif()
set(UB_API "${_ub_default}" CACHE STRING "UB SDK: none, memlink, ubsm")
set_property(CACHE UB_API PROPERTY STRINGS none memlink ubsm)
if(NOT UB_API MATCHES "^(none|memlink|ubsm)$")
  message(FATAL_ERROR "UB_API must be none, memlink or ubsm")
endif()
if(WITH_UB AND NOT UB_API STREQUAL "memlink")
  message(FATAL_ERROR "WITH_UB=ON means Memlink; use WITH_UB=OFF with UB_API=${UB_API}")
endif()
message(STATUS "Global UB API: ${UB_API}")
if(UB_API STREQUAL "memlink")
  set(UB_MEMLINK_LIBRARY "" CACHE FILEPATH "Vendor Memlink library")
  if(NOT EXISTS "${UB_MEMLINK_LIBRARY}")
    message(FATAL_ERROR "UB_API=memlink requires UB_MEMLINK_LIBRARY")
  endif()
  target_compile_definitions(shm-lib PUBLIC SHM_LIB_WITH_UB)
  target_link_libraries(shm-lib PUBLIC "${UB_MEMLINK_LIBRARY}")
elseif(UB_API STREQUAL "ubsm")
  find_path(UBSM_INCLUDE_DIR NAMES ubs_mem.h HINTS /usr/local/ubs_mem/include)
  find_library(UBSM_LIBRARY NAMES ubsm_sdk HINTS /usr/local/ubs_mem/lib)
  if(NOT EXISTS "${UBSM_INCLUDE_DIR}/ubs_mem.h" OR
     NOT EXISTS "${UBSM_INCLUDE_DIR}/ubs_mem_def.h" OR NOT EXISTS "${UBSM_LIBRARY}")
    message(FATAL_ERROR "UB_API=ubsm requires matching UBSM_INCLUDE_DIR and UBSM_LIBRARY; no fallback")
  endif()
  target_include_directories(shm-lib PRIVATE "${UBSM_INCLUDE_DIR}")
  target_compile_definitions(shm-lib PUBLIC SHM_LIB_WITH_UBSM SHM_DISABLE_CAS128)
  target_link_libraries(shm-lib PUBLIC "${UBSM_LIBRARY}")
endif()
